{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christianhoerauf.de/schema/answer.schema.json",
  "title": "Antwort des Bots (ADR system/0003)",
  "type": "object",
  "required": ["text"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "gimmick": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string", "minLength": 1 } }
    },
    "keyword": {
      "description": "Kurze Überschrift einer Antwort aus der Wissensbasis: ein oder zwei Wörter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "suggestions": {
      "description": "Folgefragen zu einer Antwort aus der Wissensbasis.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
