{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christianhoerauf.de/schema/lebenslauf.schema.json",
  "title": "Öffentlicher Lebenslauf (GET /lebenslauf?variante=<Nummer>)",
  "type": "object",
  "required": ["abschnitte"],
  "additionalProperties": false,
  "properties": {
    "abschnitte": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "titel", "eintraege"],
            "additionalProperties": false,
            "properties": {
              "name": { "enum": ["beruf", "lehre", "studium", "zivildienst", "schule"] },
              "titel": { "type": "string", "minLength": 1 },
              "eintraege": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["zeit", "titel", "organisation", "stichpunkte"],
                  "additionalProperties": false,
                  "properties": {
                    "zeit": { "type": "string", "minLength": 1 },
                    "titel": { "type": "string", "minLength": 1 },
                    "organisation": { "type": "string" },
                    "stichpunkte": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["name", "titel", "eintraege"],
            "additionalProperties": false,
            "properties": {
              "name": { "const": "projekte" },
              "titel": { "type": "string", "minLength": 1 },
              "eintraege": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["titel", "link", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "titel": { "type": "string", "minLength": 1 },
                    "link": { "type": ["string", "null"] },
                    "text": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
