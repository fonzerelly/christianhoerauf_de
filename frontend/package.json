{
  "name": "christianhoerauf-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --coverage",
    "test:properties": "vitest run --config vitest.properties.config.ts",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test:visual": "./scripts/in-playwright-docker.sh npx playwright test",
    "test:visual:update": "./scripts/in-playwright-docker.sh npx playwright test --update-snapshots",
    "test:lighthouse": "./scripts/in-playwright-docker.sh ./scripts/lighthouse.sh",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:architecture",
    "check:all": "npm run check && npm run test:properties && npm run test:visual && npm run test:lighthouse"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
